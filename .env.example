# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://llm.aibricks.io/v1
OPENAI_MODEL=claude-haiku

# Anthropic API Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-haiku

# Default LLM Provider (openai or anthropic)
DEFAULT_PROVIDER=anthropic

# API Settings
MAX_TOKENS=8000
TEMPERATURE=0.7
RETRY_ATTEMPTS=3

# RAG Settings
USE_RAG=true

# Memory Settings
USE_MEMORY=true

# Evaluation Frameworks
# RAGAS: Evaluate RAG retrieval and generation quality
ENABLE_RAGAS=true

# DeepEval: Evaluate LLM output quality with custom domain metrics
ENABLE_DEEPEVAL=true

# LangGraph: Graph-based multi-agent orchestration with state management
USE_LANGGRAPH=true

# Evaluation Storage Directories
RAGAS_EVAL_DIR=memory/evaluation
DEEPEVAL_EVAL_DIR=memory/evaluation
LANGGRAPH_CHECKPOINT_DIR=memory/checkpoints

# Analysis Service Settings
# Enable unified evaluation orchestrator
ENABLE_EVALUATION_ORCHESTRATOR=true

# Enable analysis service with LangGraph
ENABLE_ANALYSIS_SERVICE=true

# LangSmith Tracing (optional)
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=incident-response-agent
